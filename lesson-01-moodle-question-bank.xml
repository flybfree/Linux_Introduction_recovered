  <question type="multichoice">
    <name><text>Purpose of an operating system</text></name>
    <questiontext format="html"><text><![CDATA[<p>Which statement best describes the primary purpose of an operating system?</p>]]></text></questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.0000000</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html"><text><![CDATA[<p>It manages computer resources and provides common services for applications.</p>]]></text><feedback format="html"><text><![CDATA[<p>Correct. The operating system manages hardware and provides services and abstractions for users and applications.</p>]]></text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[<p>It replaces the computer's physical hardware.</p>]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[<p>It is only the graphical desktop displayed to the user.</p>]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[<p>It is a collection of documents stored on the computer.</p>]]></text></answer>
  </question>

